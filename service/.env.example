# Copy the names into the host environment. Leave the values empty here.
# The current proof-of-concept host is Vercel. The names are host-neutral.
# Generate values on your machine and paste them into the host. Do not commit the filled file.

# Neon Marketplace injects this. Pooled connection string.
DATABASE_URL=

# Optional. Direct connection used for CREATE TABLE. Neon injects this too.
DATABASE_URL_UNPOOLED=

# Base64 of a 32-byte Ed25519 seed. Signs transparency-log tree heads.
KATA_LOG_SIGNING_SEED=

# Public JWK JSON of the key that signs revocation push webhooks. Not a private key.
KATA_PUSH_NOTIFIER_JWK=

# Bearer token required by POST /v1/log/entries.
KATA_APPEND_TOKEN=

# Optional JSON array of extra records for /.well-known/kata-keys.json.
# KATA_PUBLISHED_KEYS=[{"public_key":{"kty":"OKP","crv":"Ed25519","x":"REPLACE"}}]

# Optional. Defaults to the Frankfurter ECB daily feed.
# KATA_FX_SOURCE_URL=https://api.frankfurter.dev/v1

# Admin bearer for creating organizations and reviewing disputes.
GAB_ADMIN_TOKEN=

# Optional bureau limits. Defaults: 120 per minute, 60 verifies, 30 inquiries, 10 reports.
# GAB_RATE_LIMIT_PER_MINUTE=120
# GAB_VERIFY_RATE_LIMIT_PER_MINUTE=60
# GAB_INQUIRY_RATE_LIMIT_PER_MINUTE=30
# GAB_REPORT_RATE_LIMIT_PER_MINUTE=10
# GAB_REPORT_DAILY_CAP=20
# GAB_MAGIC_LINK_TTL_SECONDS=900
# GAB_SESSION_TTL_SECONDS=43200

# SMTP for portal sign-in mail. Leave these empty to keep mail off.
# GAB_SMTP_HOST=smtp.gmail.com
# GAB_SMTP_PORT=587
GAB_SMTP_USER=
GAB_SMTP_PASSWORD=
GAB_SMTP_FROM=
# Origin written into the sign-in link.
# GAB_PUBLIC_BASE_URL=https://globalagentbureau.com

# Local only. Do not set GAB_DEMO on production: it ignores DATABASE_URL.
# GAB_DEV_MAILBOX=1
# GAB_DEMO=1

# Key custody for the proof of concept. The default provider is env when
# GAB_ENV is not production: one master key in this environment (mark it
# Sensitive on Vercel) wraps per-person data keys stored in gab_subject_deks.
# GAB_SUBJECT_REF_KEY is a separate secret. It keys subject_ref. Rotating
# the master key does not change subject_ref. GAB_MASTER_KEY_ID is the id
# stored in the wrap. Unset means master. Do not replace the bytes behind
# an existing id. aws-kms is not the default. The env provider is refused
# when GAB_ENV is production. No flag overrides that. Real customer personal
# data requires a KMS decision and the hosting migration first. Do not put
# key material here. Do not set AWS_ACCESS_KEY_ID. The future AWS path is
# Vercel OIDC.
# GAB_MASTER_KEY=
# GAB_MASTER_KEY_ID=
# GAB_KEY_PROVIDER=
# GAB_HMAC_KEYS=
# GAB_HMAC_ACTIVE_KID=
# GAB_KMS_KEY_ID=
# GAB_KMS_REGION=
# GAB_KMS_WRAPPED_HMAC_KEYS=
# GAB_SUBJECT_REF_KEY=
# GAB_SUBJECT_REF_KID=
# AWS_ROLE_ARN=
# AWS_WEB_IDENTITY_TOKEN_FILE=
# GAB_KEYED_IDENTIFIERS=0
# GAB_HMAC_RATE_SUBJECT=0
# GAB_STOP_PLAINTEXT_EMAIL=0
# GAB_CONSENT_EVENTS=0
# GAB_CONSENT_PUSH=0
# GAB_CONSENT_NETWORK=0
# GAB_ENTITY_ONLY=0
# GAB_NETWORK_STEP_UP=0
# GAB_LEDGER_HYGIENE=0
# Payload ciphertext is gab_payloads. Wrapped data keys are gab_subject_deks.
# GAB_BREACH_TOOLS=0

# Set to 1 only while loading the public demo into the database, then unset it.
# POST /v1/admin/seed-demo requires the GAB_ADMIN_TOKEN bearer and this flag.
# GAB_ALLOW_DEMO_SEED=1
